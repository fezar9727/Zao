# Copiar este archivo como application-local.properties (mismo directorio)
# y completar con tus datos reales. application-local.properties NUNCA se
# sube al repositorio (ya debe estar en el .gitignore).

spring.application.name=backend

# --- Base de datos ---
spring.datasource.url=jdbc:mysql://localhost:3306/zao_db?useSSL=false&serverTimezone=America/Bogota
spring.datasource.username=TU_USUARIO_MYSQL
spring.datasource.password=TU_CONTRASENA_MYSQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / Hibernate ---
# IMPORTANTE: siempre "validate", nunca "update" ni "create". El esquema de
# la base de datos lo controla Flyway a traves de las migraciones V1...V10,
# no Hibernate. Si esto dice "update" o "create", Hibernate podria alterar
# el esquema por fuera de las migraciones versionadas, lo cual esta
# explicitamente prohibido por las reglas del proyecto.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# --- Flyway ---
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# --- Servidor ---
server.port=8090
